{
  "expo": {
    "name": "Polydraft",
    "slug": "polydraft",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "polydraft",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a1a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.polydraft.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a1a"
      },
      "package": "com.polydraft.mobile",
      "minSdkVersion": 26,
      "targetSdkVersion": 34
    },
    "plugins": [
      "expo-font",
      "expo-image",
      "expo-av"
    ],
    "extra": {
      "SUPABASE_URL": "${EXPO_PUBLIC_SUPABASE_URL}",
      "SUPABASE_ANON_KEY": "${EXPO_PUBLIC_SUPABASE_ANON_KEY}",
      "ACTIVE_VENUE": "${EXPO_PUBLIC_ACTIVE_VENUE}",
      "eas": {
        "projectId": "your-eas-project-id"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/your-eas-project-id"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
