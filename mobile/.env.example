# ============================================
# Polydraft Mobile - Environment Variables
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Expo reads EXPO_PUBLIC_ prefixed vars at build time.
# They are inlined into the JS bundle — never put secrets here.

# ---- Supabase ----
# Get these from your Supabase project: Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---- Venue ----
# Which prediction market venue to use: polymarket | jupiter
EXPO_PUBLIC_ACTIVE_VENUE=jupiter

# ---- Solana ----
# Payment method: program (on-chain program) | transfer (SPL transfer)
EXPO_PUBLIC_PAYMENT_METHOD=program

# Purchase program deployed on mainnet/devnet
EXPO_PUBLIC_PURCHASE_PROGRAM_ID=2kFruWkndEjnMJkFR5dkKbLjuCpoZ2nx3rHx9KFutKx1

# Treasury wallet that receives pack payments
EXPO_PUBLIC_TREASURY_PUBKEY=11111111111111111111111111111111

# Solana RPC endpoint (devnet for development, mainnet-beta for production)
EXPO_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# ---- API (optional) ----
# Base URL if the app needs to call a backend REST API
# Leave blank to use direct Supabase calls only
EXPO_PUBLIC_API_BASE_URL=
